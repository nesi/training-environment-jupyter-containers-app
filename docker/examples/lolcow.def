Bootstrap: docker
From: ubuntu:22.04

%post
    apt-get update
    apt-get install -y cowsay lolcat
    rm -rf /var/lib/apt/lists/*
    ln -s /usr/games/cowsay /usr/bin/cowsay
    ln -s /usr/games/lolcat /usr/bin/lolcat

%environment
    export LC_ALL=C

%runscript
    date | cowsay | lolcat

%labels
    Author REANNZ training
    Version v0.1.0

%help
    A container that tells you the date, via a cow, in colour.

    Build it with:
        apptainer build --fakeroot lolcow-custom.sif lolcow.def

    Run it with:
        apptainer run lolcow-custom.sif
